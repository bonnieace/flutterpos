rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rootUserPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function staffPath(tenantId, uid) {
      return /databases/$(database)/documents/tenants/$(tenantId)/staff/$(uid);
    }

    function globallyActive() {
      return signedIn()
        && exists(rootUserPath(request.auth.uid))
        && get(rootUserPath(request.auth.uid)).data.globalStatus == 'active'
        && (
          !('authValidAfterSeconds' in get(rootUserPath(request.auth.uid)).data)
          || (
            get(rootUserPath(request.auth.uid)).data.authValidAfterSeconds is int
            && request.auth.token.auth_time is int
            && request.auth.token.auth_time
              >= get(rootUserPath(request.auth.uid)).data.authValidAfterSeconds
          )
        );
    }

    function tenantIdentity() {
      return globallyActive()
        && get(rootUserPath(request.auth.uid)).data.accountType == 'tenant_user';
    }

    // **A business that may be traded in.** A business is active from the
    // moment `requestTenant` creates it, so this is the whole of the question:
    // `suspended` and `archived` are the only ways out, and both go dark.
    function tradingTenant(tenantId) {
      return exists(tenantPath(tenantId))
        && get(tenantPath(tenantId)).data.status == 'active';
    }

    // The membership half of both gates, factored out so the two cannot drift.
    function staffStanding(tenantId) {
      return tenantIdentity()
        && exists(staffPath(tenantId, request.auth.uid))
        && get(staffPath(tenantId, request.auth.uid)).data.uid == request.auth.uid
        && get(staffPath(tenantId, request.auth.uid)).data.status == 'active'
        && get(staffPath(tenantId, request.auth.uid)).data.role
          in ['owner', 'admin', 'manager', 'cashier']
        && (
          get(staffPath(tenantId, request.auth.uid)).data.role != 'owner'
          || get(tenantPath(tenantId)).data.ownerUid == request.auth.uid
        );
    }

    // **May act on this business**, for reads and writes alike. The read/write
    // split that used to live here existed only so a lapsed provisional request
    // could still see the week it traded; with no provisional state left, one
    // predicate answers both.
    function activeStaff(tenantId) {
      return staffStanding(tenantId) && tradingTenant(tenantId);
    }

    function tenantRole(tenantId) {
      return get(staffPath(tenantId, request.auth.uid)).data.role;
    }

    function hasTenantRole(tenantId, roles) {
      return activeStaff(tenantId) && tenantRole(tenantId) in roles;
    }

    function platformAdmin() {
      return globallyActive()
        && request.auth.token.platformRole == 'superAdmin'
        && get(rootUserPath(request.auth.uid)).data.accountType == 'platform_admin';
    }

    // A receipt must describe the sale's own business date and sequence.
    // Client state issues the number, so the server refuses any receipt that
    // disagrees with the immutable sale envelope it is written with.
    //
    // The shape, the embedded date, and the embedded sequence are proved by one
    // constructed pattern rather than by separate comparisons: a sale may carry
    // sixteen lines, and Firestore evaluates at most 1000 expressions per
    // request. The three-character device code is a SHA-256 digest that Rules
    // cannot recompute, and Rules cannot query other sales, so cross-sale
    // uniqueness stays a device-local and reconciliation concern.
    // `businessDate` and `deviceId` are not type-checked here: a non-string
    // date cannot be split into the pattern, and the shift comparison below
    // proves the device against the shift's own validated string.
    function validSaleReceipt(sale) {
      return sale.receiptSequence is int
        && sale.receiptSequence > 0
        && sale.receiptNumber is string
        // "CT-" + 3 + "-" + 8 + "-" is 16 characters, so the frozen
        // four-digit minimum sequence width makes 20 the shortest receipt.
        && sale.receiptNumber.size() >= 20
        && sale.receiptNumber.matches(
          '^CT-[0-9A-F]{3}-' + sale.businessDate.split('-').join('')
          + '-0{0,3}' + string(sale.receiptSequence) + '$'
        );
    }

    // How the customer paid, as the cashier asserted it at the till. Nothing
    // authorizes a card, queries an M-Pesa push, or reconciles a provider
    // statement anywhere in this system, so the field records a selection and
    // never a verified payment. It is still constrained to the three modelled
    // values: the `sales` create rule deliberately does not freeze its key set
    // with `hasOnly`, so an unconstrained tender would be an arbitrary
    // client-chosen string and therefore evidence of nothing at all.
    //
    // Schema v1 predates the decision and must carry no tender. That version
    // stays accepted on purpose: a device holding an unsubmitted v1 draft
    // across the upgrade must still be able to commit it, and its payload hash
    // covers the whole payload, so rewriting the draft to v2 would break the
    // hash the server sale is matched against during confirmation. Refusing v1
    // here would strand exactly that evidence.
    //
    // An absent or non-integer `payloadSchemaVersion` now denies the create.
    // The rule previously ignored the field entirely; a sale that does not say
    // which contract it was written under cannot be checked against one.
    function validSaleTender(sale) {
      return (sale.payloadSchemaVersion == 1 && !('tender' in sale))
        || (
          sale.payloadSchemaVersion == 2
          && 'tender' in sale
          && sale.tender in ['cash', 'mpesa', 'card']
        );
    }

    function shiftPath(tenantId, shiftId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/shifts/$(shiftId);
    }

    // Every sale belongs to exactly one canonical shift held by the same
    // cashier, on the same device, in the same business day. Nightly
    // reconciliation aggregates sales per shift and business date and compares
    // the result against that shift's own closing summary, so an unattributed
    // or foreign-shift sale could never be reconciled.
    //
    // A closed shift is deliberately still accepted: an offline sale may reach
    // the server after its shift closed, and refusing it would strand evidence
    // the device can no longer correct. Reconciliation reports the variance.
    //
    // The shift is read once into a local binding: a sale may carry sixteen
    // lines, and Firestore evaluates at most 1000 expressions per request, so
    // repeating the path and the lookup for each field exhausts the budget and
    // denies a legitimate maximum-size sale.
    function validSaleShift(tenantId, sale) {
      let shift = get(shiftPath(tenantId, sale.shiftId));
      return shift != null
        && shift.data.staffId == request.auth.uid
        && shift.data.deviceId == sale.deviceId
        && shift.data.businessDate == sale.businessDate;
    }

    // A non-map line cannot answer these field accesses, so the evaluation
    // error denies the write without spending an extra type check per line.
    function validSaleLine(line) {
      return line.productId is string
        && line.productId.size() > 0
        && line.quantity is int
        && line.quantity > 0;
    }

    function validSaleLines(lines) {
      return lines is list
        && lines.size() > 0
        && lines.size() <= 16
        && (lines.size() <= 0 || validSaleLine(lines[0]))
        && (lines.size() <= 1 || validSaleLine(lines[1]))
        && (lines.size() <= 2 || validSaleLine(lines[2]))
        && (lines.size() <= 3 || validSaleLine(lines[3]))
        && (lines.size() <= 4 || validSaleLine(lines[4]))
        && (lines.size() <= 5 || validSaleLine(lines[5]))
        && (lines.size() <= 6 || validSaleLine(lines[6]))
        && (lines.size() <= 7 || validSaleLine(lines[7]))
        && (lines.size() <= 8 || validSaleLine(lines[8]))
        && (lines.size() <= 9 || validSaleLine(lines[9]))
        && (lines.size() <= 10 || validSaleLine(lines[10]))
        && (lines.size() <= 11 || validSaleLine(lines[11]))
        && (lines.size() <= 12 || validSaleLine(lines[12]))
        && (lines.size() <= 13 || validSaleLine(lines[13]))
        && (lines.size() <= 14 || validSaleLine(lines[14]))
        && (lines.size() <= 15 || validSaleLine(lines[15]));
    }

    // The business-wide view of every product's stock ledger.
    //
    // A collection group is the only read here Firestore does not bound by a
    // path prefix: the per-product rule below `tenants/{tenantId}/products`
    // does not apply to a group query at all, so this is a separate boundary
    // and is reasoned about as one.
    //
    // It is `list` only, so it authorizes a query and never an individual
    // document. A single movement is still read through the per-product rule,
    // where the tenant is the path wildcard, and an absent one still answers
    // there rather than raising an evaluation error here.
    //
    // The authorization is `resource.data.tenantId`, which Firestore can only
    // resolve when the query itself carries that exact equality filter. An
    // unfiltered group page is therefore refused outright, and a page filtered
    // to another business fails the role check - the client attaches the filter
    // from its own live session and can never drop it. The roles are the same
    // owner/admin/manager set the per-product ledger and `stock_adjustments`
    // use, so the surface that explains one product's figure and the surface
    // that lists everything that moved agree about who may see them.
    //
    // Writing stays server-only everywhere, so a document's `tenantId` is
    // always the one its own path encodes; the client re-proves that path
    // anyway before showing a row.
    match /{ledgerPath=**}/stock_movements/{movementId} {
      allow list: if hasTenantRole(
        resource.data.tenantId,
        ['owner', 'admin', 'manager']
      );
      allow get, write: if false;
    }

    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || platformAdmin();
      allow list: if platformAdmin();
      allow create, update, delete: if false;

      match /tenant_memberships/{tenantId} {
        allow read: if tenantIdentity() && request.auth.uid == uid;
        allow write: if false;
      }

      match /tenant_request_events/{eventId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /tenants/{tenantId} {
      allow read: if activeStaff(tenantId) || platformAdmin();
      allow write: if false;

      // A canonical staff record carries the member's email and phone number,
      // so a cashier reads only its own. Owners, admins, and managers read the
      // whole roster, which is what the staff directory already requires.
      // History surfaces therefore label a colleague by UID for a cashier and
      // by name for management, which the name resolver degrades to on its own.
      //
      // The identity is the path wildcard, not a field, so an absent record
      // still answers rather than raising an evaluation error.
      match /staff/{uid} {
        allow read: if platformAdmin()
          || (
            activeStaff(tenantId)
            && (
              uid == request.auth.uid
              || tenantRole(tenantId) in ['owner', 'admin', 'manager']
            )
          );
        allow write: if false;
      }

      match /staff_invitations/{uid} {
        allow read, write: if false;
      }

      match /products/{productId} {
        allow read: if activeStaff(tenantId);

        // **Server-only since 2026-09-13.** This admitted any document three
        // roles cared to write, checking one field of it, and the client was
        // the only thing standing between a business and a product its own till
        // could not parse. It could not be tightened in place either: a create
        // may now carry an opening quantity, and the `stock_adjustments` record
        // and `stock_movements` entry that say where those units came from are
        // server-write-only - so the product and its ledger entry have to be
        // written by one principal, in one transaction. `createProduct` is that
        // principal. It reads the resulting document through the same strict
        // reader every device reads it with, and a device reaches it through the
        // mutation outbox, so adding a product still works with no connection.
        //
        // `allow update` and `allow delete` below are unchanged: the checkout
        // decrement and retiring a product are both still client writes.
        allow create: if false;

        allow update: if activeStaff(tenantId)
          && resource.data.quantity is int
          && request.resource.data.quantity is int
          && request.resource.data.quantity < resource.data.quantity
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;

        // **Server-only since 2026-09-13, and no longer a delete at all.**
        // "Retire" removed the document: the quantity went with it, no movement
        // recorded the stock leaving, every past sale line went on naming an ID
        // nothing answered to, and the `stock_movements` below it were orphaned
        // rather than removed - Firestore keeps a subcollection when its parent
        // goes, so the ledger survived with no way into it. `setProductRetired`
        // sets a flag and writes the movement that clears the stock in one
        // transaction, which is the same rule `createProduct` follows in the
        // other direction: whoever writes the quantity writes the movement.
        allow delete: if false;

        // The append-only ledger of everything that moved this product's
        // stock: sales, verified returns, and manual adjustments. It is
        // deliberately narrower than the product document a cashier reads.
        // The current quantity is operational information every member needs
        // at the till; the ledger names damage, waste, corrections, and who
        // recorded them, which is management information in exactly the way
        // `daily_metrics` is. It is also the same set of roles `adjustStock`
        // itself enforces, so the surface that explains a stock figure and the
        // surface that changes it agree.
        //
        // The role check touches no document field, so an absent movement -
        // and a product with an empty ledger - still answers instead of
        // raising an evaluation error.
        //
        // Writing stays server-only. Every entry is created by a callable or a
        // reconciliation worker inside the same transaction that changes the
        // quantity, so a client that could append here could claim a movement
        // that never happened.
        match /stock_movements/{movementId} {
          allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
          allow write: if false;
        }
      }

      match /categories/{categoryId} {
        allow read: if activeStaff(tenantId);
        // **Server-written since 2026-09-14, and for one reason.** Two
        // categories folding to the same name cannot be told apart when a
        // spreadsheet names that category, so `importProducts` refuses the row
        // rather than guessing - and the only way it can be asked again is by
        // document ID, which nothing in this product shows anybody. Preventing
        // the ambiguity means reading every other category in the collection,
        // and a rule may read the document being written and named documents,
        // never a query. So `createCategory` and `renameCategory` make the
        // check inside the transaction that writes, and a device queues the
        // call exactly as it queues a product create.
        allow create, update: if false;
        allow delete: if hasTenantRole(
          tenantId,
          ['owner', 'admin', 'manager']
        );
      }

      match /sales/{saleId} {
        // Direct reads stay business-wide for deterministic checkout
        // confirmation and existing return workflows. Collection searches are
        // narrower: management may inspect the business, while a cashier's
        // query must prove every possible result was issued by that cashier.
        // Firestore evaluates the candidate result set rather than filtering it
        // after the read, so an unscoped or foreign cashier query is denied.
        allow get: if activeStaff(tenantId);
        allow list: if hasTenantRole(
            tenantId,
            ['owner', 'admin', 'manager']
          )
          || (
            hasTenantRole(tenantId, ['cashier'])
            && resource.data.soldById == request.auth.uid
          );
        allow create: if activeStaff(tenantId)
          && saleId == request.resource.data.checkoutId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.soldById == request.auth.uid
          && request.resource.data.payloadHash is string
          && request.resource.data.payloadHash.size() > 0
          && request.resource.data.createdAt == request.time
          && validSaleTender(request.resource.data)
          && validSaleReceipt(request.resource.data)
          && request.resource.data.shiftId is string
          && request.resource.data.shiftId.size() > 0
          && validSaleShift(tenantId, request.resource.data)
          && validSaleLines(request.resource.data.items);
        allow update, delete: if false;
      }

      // A shift is opened and closed by its own cashier on one device. The
      // document repeats its identity so a client cannot file a shift under
      // another business, and both lifecycle instants are server-owned so a
      // device clock can never decide when a shift began or ended.
      match /shifts/{shiftId} {
        // A cashier reads only their own shifts; owners, admins, and managers
        // read every cashier's. A cashier had no reason to read a colleague's
        // counted cash, and the client already refuses a foreign shift, so the
        // server now agrees with it. A cashier's list query must therefore
        // carry `staffId == uid`, which is exactly what the history and
        // discovery repositories send.
        //
        // An absent document is deliberately readable: `resource` is null for a
        // missing shift, and a field comparison would deny the read instead of
        // answering it. Settlement after an unacknowledged create depends on
        // that answer - only a successful read may conclude that nothing was
        // written - and a document that does not exist discloses nothing.
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager'])
          || (
            activeStaff(tenantId)
            && (resource == null || resource.data.staffId == request.auth.uid)
          );
        allow create: if activeStaff(tenantId)
          && shiftId == request.resource.data.shiftId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.staffId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() > 0
          && request.resource.data.businessDate is string
          && request.resource.data.businessDate.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          )
          && request.resource.data.startTime == request.time
          && !('endTime' in request.resource.data);
        allow update: if activeStaff(tenantId)
          && resource.data.staffId == request.auth.uid
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.shiftId == resource.data.shiftId
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.businessDate == resource.data.businessDate
          && request.resource.data.startTime == resource.data.startTime
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.endTime == request.time
          && request.resource.data.closingCashMinor is int
          && request.resource.data.closingCashMinor >= 0
          && request.resource.data.closingCashMinor <= 1000000000000
          && request.resource.data.closingCash is number
          && request.resource.data.closingCash >= 0
          // The sale-derived summary nightly reconciliation verifies. It is
          // mandatory: a shift closed without it is reported as
          // invalid_or_missing_shift and can never be matched.
          && request.resource.data.transactionCount is int
          && request.resource.data.transactionCount >= 0
          && request.resource.data.totalSalesMinor is int
          && request.resource.data.totalSalesMinor >= 0
          && request.resource.data.totalSales is number
          && request.resource.data.totalSales >= 0
          && (
            request.resource.data.totalSalesMinor == 0
            || request.resource.data.transactionCount > 0
          )
          // The blind tender declaration: what the cashier says the till holds,
          // by method, entered without being shown what is expected of it.
          //
          // **All three or none.** A partial declaration is not a smaller
          // truth, it is a different figure wearing the same label - the two
          // absent methods would read as zero to every surface downstream.
          //
          // **`declaredCashMinor` restates `closingCashMinor` rather than
          // replacing it**, so no reader can be shown two cash figures for one
          // drawer that disagree, and every surface built on the older name
          // keeps working.
          //
          // Optional for this release, and deliberately: making it mandatory
          // now would deny the close to every device still running the previous
          // build, including the replay of a close one of them recorded offline
          // - which would retry forever with no way out. The server treats a
          // close made after the rollout with no declaration as a difference of
          // its own, so omission is caught without breaking anyone.
          && (
            (
              !('declaredCashMinor' in request.resource.data)
              && !('declaredMpesaMinor' in request.resource.data)
              && !('declaredCardMinor' in request.resource.data)
            ) || (
              request.resource.data.declaredCashMinor is int
              && request.resource.data.declaredCashMinor >= 0
              && request.resource.data.declaredCashMinor <= 1000000000000
              && request.resource.data.declaredCashMinor
                == request.resource.data.closingCashMinor
              && request.resource.data.declaredMpesaMinor is int
              && request.resource.data.declaredMpesaMinor >= 0
              && request.resource.data.declaredMpesaMinor <= 1000000000000
              && request.resource.data.declaredCardMinor is int
              && request.resource.data.declaredCardMinor >= 0
              && request.resource.data.declaredCardMinor <= 1000000000000
            )
          )
          // A recovery close, made by a device that holds none of this shift's
          // sales and therefore cannot summarize it. The flag is never written
          // false - an ordinary close omits it entirely - and it forces the
          // summary to zero, which reconciliation is told not to believe rather
          // than reading as a shift that took nothing.
          && (
            !('closedWithoutEvidence' in request.resource.data)
            || (
              request.resource.data.closedWithoutEvidence == true
              && request.resource.data.totalSalesMinor == 0
              && request.resource.data.totalSales == 0
              && request.resource.data.transactionCount == 0
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'endTime', 'closingCashMinor', 'closingCash',
              'totalSales', 'totalSalesMinor', 'transactionCount',
              'declaredCashMinor', 'declaredMpesaMinor', 'declaredCardMinor',
              'closedWithoutEvidence'
            ]);
        allow delete: if false;
      }

      // A return is the business's shared record of a reversal, so the read is
      // deliberately as wide as the sale rule rather than as narrow as the
      // shift rule. `verifyReturnAndRestoreStock` bounds a restoration by the
      // immutable sale minus every prior verified return, so the quantity a
      // cashier may still request depends on returns other cashiers recorded.
      // Narrowing this to `createdBy` would hide exactly that evidence and let
      // one cashier record a return the server can never verify.
      //
      // The role check touches no document field, so an absent return still
      // answers instead of raising an evaluation error.
      //
      // Verification stays server-only: `return_verifications` and the
      // resulting stock movements are denied by the catch-all below, and no
      // client may update a return, so the terminal state, the verifier, and
      // the restoration ID can only ever be written by the callable.
      // Recording a return changes no stock. Every active member may record a
      // pending one - a customer returns to whoever is at the till, and
      // `createdBy` records who did - while restoration runs through the
      // owner/admin/manager-only `verifyReturnAndRestoreStock`. The two steps
      // are a deliberate two-person control rather than one privilege.
      //
      // The key set is frozen by `hasOnly`, so no verification field and no
      // unknown field can be smuggled in beside the request. `itemsReturned`
      // reuses `validSaleLines`: a return line and a sale line are the same
      // shape by construction, and a return can never carry more lines than the
      // sale it reverses, which is capped at the same sixteen.
      //
      // The sale must exist. A return filed against nothing could never be
      // verified, because the callable reads the immutable sale to bound the
      // restoration; refusing it here keeps that record out of the business.
      //
      // **`recordedOn` is the day the reversal was taken, and is checked for
      // shape only.** It is deliberately not bound to `request.time`, and the
      // reason is the offline path: a return recorded on Monday and replayed
      // from the durable queue on Tuesday carries Monday's value while
      // `request.time` is Tuesday's, so binding the two would refuse exactly
      // the writes the queue exists to protect. `createdAt` stays the server's
      // own and is the authority every screen displays; this field only drives
      // the returns filter, and a device with a wrong clock mis-files itself in
      // that one list rather than misstating when anything happened.
      //
      // **`businessDate` is the sale's own, copied and bound here rather than
      // trusted.** A return carries no date a report can filter on otherwise -
      // `createdAt` is when the reversal was recorded, which is a different
      // fact from the day whose takings it comes out of - so a day's sales
      // could only be netted by reading every return in the business, or one
      // query per sale on the page. The `get` is the same document `exists`
      // already proves is there, so the day on the return can never be a day
      // its sale did not happen on.
      match /returns/{returnId} {
        allow read: if activeStaff(tenantId);
        allow create: if activeStaff(tenantId)
          && returnId == request.resource.data.returnId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.saleId is string
          && request.resource.data.saleId.size() > 0
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/sales/$(request.resource.data.saleId))
          && request.resource.data.businessDate is string
          && request.resource.data.businessDate.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          )
          && request.resource.data.businessDate == get(
            /databases/$(database)/documents/tenants/$(tenantId)/sales/$(request.resource.data.saleId)
          ).data.businessDate
          && request.resource.data.createdAt == request.time
          && request.resource.data.recordedOn is string
          && request.resource.data.recordedOn.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          )
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 3
          && request.resource.data.reason.size() <= 500
          && validSaleLines(request.resource.data.itemsReturned)
          && request.resource.data.keys().hasOnly([
            'returnId', 'tenantId', 'saleId', 'businessDate', 'recordedOn',
            'createdBy', 'status', 'reason', 'itemsReturned', 'createdAt'
          ]);
        allow update, delete: if false;
      }

      // What the business spent that no sale line accounts for - rent, wages,
      // fuel, a repair. Profit as this system computes it is revenue minus the
      // cost of the goods sold, so without these a shop can be losing money
      // while every report shows a healthy margin.
      //
      // **Owner and administrator only, read as well as write.** That is the
      // same list a profit figure is shown to, and narrower than the one that
      // may read the takings: an expense is cost, and nobody should be writing
      // into a figure they are not shown. Unlike daily_metrics - which a
      // manager's device already holds in full, making its narrower surface a
      // presentation choice - this is a real boundary.
      //
      // A record is immutable once written. The only permitted update is a
      // void, which adds three keys and freezes every other one, so a mistake
      // leaves both the original and the correction on the record.
      match /expenses/{expenseId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin']);
        allow create: if hasTenantRole(tenantId, ['owner', 'admin'])
          && expenseId == request.resource.data.expenseId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.businessDate is string
          && request.resource.data.businessDate.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
          )
          // The key carries the business date because that is the only way a
          // client can read a date range: every page is ordered by document ID
          // and takes no range filter. A record whose key disagreed with its
          // own field would be counted into a period it does not belong to, so
          // the two are pinned together here rather than trusted to agree.
          // The date is checked against its own pattern first, so it cannot
          // smuggle a wildcard into this one.
          && expenseId.matches(
            '^' + request.resource.data.businessDate + '-[A-Za-z0-9_-]{1,64}$'
          )
          && request.resource.data.category in [
            'rent', 'wages', 'utilities', 'transport',
            'supplies', 'repairs', 'licences', 'other'
          ]
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 3
          && request.resource.data.description.size() <= 500
          // Zero is refused with the negatives: an expense of nothing did not
          // happen, and recording one puts a row on a report that no money
          // corresponds to.
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.amountMinor <= 100000000000
          && request.resource.data.amount is number
          && request.resource.data.keys().hasOnly([
            'expenseId', 'tenantId', 'businessDate', 'category',
            'description', 'amountMinor', 'amount', 'recordedBy', 'createdAt'
          ]);
        // The void, and nothing else. A record that has already been voided
        // cannot be re-voided or its reason reworded.
        allow update: if hasTenantRole(tenantId, ['owner', 'admin'])
          && !('voidedAt' in resource.data)
          && request.resource.data.voidedAt == request.time
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidReason is string
          && request.resource.data.voidReason.size() >= 3
          && request.resource.data.voidReason.size() <= 500
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voidedAt', 'voidedBy', 'voidReason']);
        allow delete: if false;
      }

      match /configuration/{documentId} {
        allow read: if activeStaff(tenantId);
        allow write: if hasTenantRole(tenantId, ['owner', 'admin']);
      }

      match /subscription/{documentId} {
        allow read: if activeStaff(tenantId) || platformAdmin();
        allow write: if false;
      }

      // Regenerated by nightly reconciliation and read-only for every client.
      // Business-wide revenue is management information, so a cashier - who may
      // read its own sales and shifts - does not read the day's totals.
      //
      // The role check touches no document field, so a business date that has
      // not been reconciled yet still answers. That is the normal state for
      // today, and the summary reports it as pending rather than as zero.
      match /daily_metrics/{businessDate} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // The business-wide immutable record of every manual `adjustStock`
      // correction, written in the same transaction as the product update, the
      // per-product `stock_movements` entry, and the audit record.
      //
      // The read is owner/admin/manager: the same set of roles `adjustStock`
      // enforces and the same set that reads a product's ledger, so the surface
      // that records a correction, the surface that explains one product's
      // stock figure, and the surface that lists every correction in the
      // business agree about who may see them. It is deliberately wider than
      // `audit_logs`, which is owner/admin: that collection is the whole
      // business's event trail, while this one is only the stock corrections a
      // manager both records and answers for.
      //
      // The role check touches no document field, so an absent adjustment - and
      // a business that has never recorded one - still answers instead of
      // raising an evaluation error.
      //
      // Writing stays server-only. A client that could create here could claim
      // a correction that never moved any stock, and one that could update or
      // delete could erase the only record of one that did.
      match /stock_adjustments/{adjustmentId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // What somebody counted on the shelf, and what the books said at the time.
      //
      // **Written only by `submitStockTake`**, for the reason every collection
      // around it is server-only: a count is read against the stock it will
      // later correct, so a client that could write one could write the shortage
      // it caused out of existence.
      //
      // A cashier reads their own counts and nobody else's, which is the split
      // `shifts` already makes and for the same reason - a colleague's count is
      // no more their business than a colleague's counted cash.
      //
      // **The lines are management-only, and that is the control, not an
      // oversight.** A line carries `expected`: the figure the count was taken
      // blind to. Letting the person who counted read it back would hand them
      // the number they were deliberately not shown, which is most of what a
      // blind count is for.
      match /stock_takes/{takeId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager'])
          || (activeStaff(tenantId) && resource.data.counterUid == request.auth.uid);
        allow write: if false;

        match /lines/{productId} {
          allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
          allow write: if false;
        }
      }

      // The server's own record of every reconciliation run queued for this
      // business, and of whether each business day's totals are current.
      //
      // Both are read by the same owner/admin/manager set that reads
      // `daily_metrics`, and for the same reason: this is the explanation of
      // business-wide revenue, so whoever may not see the figure may not see
      // why it is what it is either. It is deliberately wider than
      // `audit_logs`, which is owner/admin - this is reporting rather than
      // governance, and it names no staff member other than the one who
      // requested a manual run.
      //
      // `reconciliation_dirty_days` is the one authority on whether a day's
      // published totals are current, and its document ID is the business date
      // itself, so a day is read by exact path. `reconciliation_jobs` carries
      // the work: a client lists the runs of one day with a `localDate ==`
      // filter, which is served by the automatic single-field index.
      //
      // Neither role check touches a document field, so a business date the
      // server has never seen - the normal state of a day with no sales - and
      // a business that has never been reconciled both still answer instead of
      // raising an evaluation error.
      //
      // Writing stays server-only in both. A client that could write here
      // could claim a day was regenerated when it was not, mark a day clean so
      // its sales were never aggregated, or clear the failure record of a run
      // that never succeeded. Reconciliation is requested through the callable,
      // which enforces its own roles and idempotency, never by writing a job.
      match /reconciliation_jobs/{jobId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      match /reconciliation_dirty_days/{businessDate} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // The differences those runs found and could not resolve. A run already
      // reports how many it found; this is which ones, so it is read by the
      // same set for the same reason and is the detail behind a count that set
      // can already see.
      //
      // A record carries no business date - a stock or shift anomaly is about a
      // product or a shift, not a day - so a client lists them business-wide on
      // the ascending key order, optionally narrowed by one `anomalyType ==`
      // equality. Both shapes are served by the automatic single-field index.
      //
      // Writing stays server-only. Nothing here mutates stock or a shift: the
      // records themselves say `mutatesStock: false` and `mutatesShift: false`,
      // and a client that could write one could invent a discrepancy or erase
      // the only record of a real one.
      match /reconciliation_anomalies/{anomalyId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // One document, recomputed by every completed reconciliation run: how
      // many recorded differences are still open.
      //
      // It exists so a launcher can carry a badge without listing a collection
      // to count it - the anomaly documents are keyed by digest, so they cannot
      // be ordered or counted cheaply from a client. Read by exactly the set
      // that reads the differences it counts.
      match /reconciliation_summary/{summaryId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // The business-wide immutable record of every closed shift summary that
      // was amended to the total its own sales prove. `amendShiftSummary` writes
      // one in the same transaction as the shift update, the settled
      // expectation, the difference it cleared, and the audit record.
      //
      // The read is owner/admin/manager: the same set that reads the shift the
      // amendment corrected and the difference that justified it, so whoever may
      // see the corrected figure may see why it changed. Recording one is
      // owner/admin inside the callable, which is deliberately narrower -
      // rewriting a record every client treats as terminal is governance rather
      // than reporting, and it is the same set that may spend the business's
      // manual reconciliation allowance.
      //
      // A cashier is deliberately excluded, exactly as they are from
      // `stock_adjustments`: the record names the owner or administrator who
      // amended the shift and states their reason, which is the business's
      // governance rather than one shift's operational information. The
      // amendment never writes `closingCashMinor` or `closingCash`, so nothing a
      // cashier counted and is accountable for is changed by a record they
      // cannot read.
      //
      // A client lists these business-wide on the ascending key order,
      // optionally narrowed by one `shiftId ==` equality. Both shapes are served
      // by the automatic single-field index. An amendment ID is `sm_` plus a
      // digest, so document order carries no time information and the record
      // states its own instant.
      //
      // The role check touches no document field, so an absent amendment - and a
      // business that has never amended a shift - still answers instead of
      // raising an evaluation error.
      //
      // Writing stays server-only. A client that could create here could claim a
      // correction that never happened, and one that could update or delete
      // could erase the only record of one that did.
      match /shift_amendments/{amendmentId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // The whole business's event trail: every tenant request, lifecycle
      // change, staff invitation, acceptance, cancellation, role or status
      // change, owner recovery, administrative alert, stock correction,
      // verified return, and reconciliation request the server recorded.
      //
      // The read stays owner/admin and is deliberately narrower than the
      // owner/admin/manager `stock_adjustments` and `daily_metrics` surfaces. A
      // manager records and answers for stock corrections, so that manager sees
      // them; this collection also names who was invited, deactivated, and
      // recovered, which is the business's own governance rather than a shift's
      // operational information. A platform admin also reads it, because the
      // platform is the actor on the lifecycle and alert records here and must
      // be able to see what it did.
      //
      // The role check touches no document field, so an absent record - and a
      // business whose trail has not started - still answers instead of raising
      // an evaluation error.
      //
      // Writing stays server-only. A client that could create here could
      // fabricate evidence of an event that never happened, and one that could
      // update or delete could erase the only record of one that did.
      match /audit_logs/{documentId} {
        allow read: if hasTenantRole(tenantId, ['owner', 'admin']) || platformAdmin();
        allow write: if false;
      }

      match /lifecycle_history/{documentId} {
        allow read: if platformAdmin();
        allow write: if false;
      }

      match /{serverCollection}/{document=**} {
        allow read, write: if false;
      }
    }

    match /platform_config/{documentId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /platform_audit_logs/{documentId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /platform_user_operations/{documentId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /platform_membership_repair_runs/{documentId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /owner_recovery_cases/{documentId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    match /email_deliveries/{documentId} {
      allow read, write: if false;
    }

    match /email_suppressions/{documentId} {
      allow read, write: if false;
    }

    match /tenant_slugs/{slug} {
      allow read, write: if false;
    }

    match /operation_idempotency/{documentId} {
      allow read, write: if false;
    }

    match /staff/{document=**} {
      allow read, write: if false;
    }

    match /alcohol/{document=**} {
      allow read, write: if false;
    }

    match /alcoholsales/{document=**} {
      allow read, write: if false;
    }

    match /returns/{document=**} {
      allow read, write: if false;
    }

    match /shifts/{document=**} {
      allow read, write: if false;
    }

    match /stock_takes/{document=**} {
      allow read, write: if false;
    }

    match /categories/{document=**} {
      allow read, write: if false;
    }

    match /store/{document=**} {
      allow read, write: if false;
    }

    match /hwsales/{document=**} {
      allow read, write: if false;
    }

    match /hstock/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
