<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      **Declared here, not only in the debug source set.** `src/debug` has
      carried this since the Flutter template, for hot reload - so every debug
      build had it and no release build was ever checked. Nothing this app
      depends on declares it either: of every plugin in the pub cache only
      `google_mobile_ads` does, and that is not a dependency of this project.

      The app cannot work without it. Firebase, and since 2026-08-17 a receipt
      dialled straight at a printer's socket on the shop LAN, are both network.
      A permission the app fundamentally needs belongs in the manifest that
      ships rather than inherited by luck from a transitive AAR.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      **Bluetooth receipt printers**, since 2026-10-03: the printer page's
      Bluetooth tab finds, pairs and connects one, and receipts are sent to it
      over Bluetooth Classic serial (`checkout_print_transport_bluetooth.dart`).

      Android 12 and later ask once for *Nearby devices* (SCAN and CONNECT).
      `neverForLocation` is a promise that a search is never used to locate the
      phone, and it is what keeps location out of the request.

      Before Android 12 the old pair is granted at install, and a search needs
      location - capped by `maxSdkVersion`, so a current phone is never asked
      for it.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30"/>
    <application
        android:label="UzaPay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              **Coming back from the mailbox.** The verification link is minted
              with `handleCodeInApp: false`, so Firebase's own hosted handler
              consumes the oobCode and *then* redirects to the continue URL -
              which means by the time this filter fires the address is already
              verified and the app has nothing to parse. Its only job is to
              bring the app to the foreground; `OnboardingFlow`'s resume
              listener notices the verification and moves the step on.

              That is also why there is no deep-link package and no oobCode
              handling in Dart: adding either would be a second implementation
              of something Firebase has already done.

              `autoVerify` needs `/.well-known/assetlinks.json` served from each
              host below, holding this app's signing SHA-256. A device without
              the app installed follows the same URL to `public/auth/verified`
              and reads the page instead, which is the fallback rather than an
              error path.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="multitenant-pos-b8326.web.app"
                      android:path="/auth/verified"/>
                <data android:scheme="https"
                      android:host="auth.uzapay.co.ke"
                      android:path="/auth/verified"/>
            </intent-filter>
            <!--
              **The staff invitation, which is parsed rather than ignored.**
              Unlike the filter above, this URL carries the whole of the thing:
              the tenant, the invited uid, the invitation version and an HMAC
              proof. `MainActivity` hands it to Dart over `pos/launch-link` and
              `TenantRoutingShell` accepts the invitation with it.

              Until 2026-09-08 this filter did not exist, so the emailed link
              opened a browser and landed on `public/staff/invitation.html`,
              which told the reader to accept in the app - and the app, for the
              same invitees, told them to use the link in the email. Neither
              statement was reachable from the other.

              A device without the app installed still follows the URL to that
              page, which is now written as the fallback it always was.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="multitenant-pos-b8326.web.app"
                      android:path="/staff/invitation"/>
                <data android:scheme="https"
                      android:host="auth.uzapay.co.ke"
                      android:path="/staff/invitation"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
