<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Merged into the main manifest for debug builds only, which is what
         keeps the release binary on Android's default refusal of cleartext
         however this source set changes. See the config itself for why a local
         Firebase emulator run cannot work without it. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
