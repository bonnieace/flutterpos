<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only permission to speak plain HTTP to a local Firebase emulator suite.

  The emulators serve HTTP, and Android has refused cleartext by default since
  API 28. Without this the `USE_FIREBASE_EMULATORS` switch derives the right
  host and then every call fails with "Cleartext HTTP traffic to 10.0.2.2 not
  permitted" - which is what a real run found, because the derivation had unit
  tests and the wire had never been used.

  It lives under `src/debug` on purpose. A release manifest never merges this
  source set, so the release binary keeps Android's default refusal whatever
  this file says. That is the same guarantee `lib/dev/firebase_emulators.dart`
  makes in Dart by throwing outside a debug build, stated again where the
  platform is the one enforcing it.

  The listed hosts are exactly the ones `derivedEmulatorHost` can return, and
  nothing else. A blanket `base-config` would also cover whatever else a debug
  build happened to talk to. `test/dev/firebase_emulators_test.dart` reads this
  file and fails if the two ever drift apart.

  A physical handset reached over a LAN address, via the FIREBASE_EMULATOR_HOST
  define, is not covered and must have that address added here for the duration;
  see `rules-tests/README.md`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- What an Android emulator calls the machine hosting it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The loopback every other target resolves to. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
