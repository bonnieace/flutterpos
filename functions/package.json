{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "owner-recovery": "npm run build && node lib/cli/ownerRecovery.js",
    "grant-platform-admin": "npm run build && node lib/cli/grantPlatformAdmin.js",
    "revoke-platform-admin": "npm run build && node lib/cli/revokePlatformAdmin.js",
    "backfill-product-search": "npm run build && node lib/cli/backfillProductSearch.js",
    "backfill-staff-search": "npm run build && node lib/cli/backfillStaffSearch.js",
    "whatsapp-webhook": "npm run build && node lib/cli/whatsappWebhookOverride.js",
    "wipe-project": "npm run build && node lib/cli/wipeProject.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
