# Daily WhatsApp report (src/dayReport). Written out in full because the
# Firebase CLI prompts for a parameter even when it has a default.
# With WHATSAPP_PHONE_NUMBER_ID or DAY_REPORT_RECIPIENT "unset" nothing is sent.
# The access token is a secret: firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=1295246753661840
WHATSAPP_GRAPH_VERSION=v23.0
DAY_REPORT_TEMPLATE=thamani_day_summary_v1
DAY_REPORT_TEMPLATE_LANGUAGE=en
DAY_REPORT_RECIPIENT=+254724682932
