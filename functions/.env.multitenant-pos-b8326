# Deployed parameter values for the dev project (multitenant-pos-b8326).
#
# `firebase-tools` reads `.env.<projectId>` at DEPLOY time, which is what makes
# the deploy non-interactive: without it the CLI stops and prompts for each
# `defineString` it cannot resolve. It is the deploy-time counterpart to
# `.env.local`, which the emulator reads and a deploy never does.
#
# Nothing secret belongs here - these are parameters, visible in the deployed
# function's configuration. Secrets live in Secret Manager and are set with
# `firebase functions:secrets:set`.
#
# The three URLs must be on a domain in Firebase Auth -> Settings -> Authorized
# domains, because two of them are handed to `generateEmailVerificationLink` /
# `generatePasswordResetLink` as `url:` and Auth refuses an unauthorized
# continue URI - which fails the whole send rather than merely landing nowhere.
# `<project>.web.app` is on that list by default, and is where `public/` deploys.

EMAIL_SENDER_NAME=UzaPay
STAFF_INVITATION_SENDER_NAME=UzaPay

EMAIL_SENDER_ADDRESS=noreply@uzapay.co.ke
STAFF_INVITATION_SENDER_EMAIL=noreply@uzapay.co.ke

EMAIL_VERIFICATION_CONTINUE_URL=https://auth.uzapay.co.ke/auth/verified
PASSWORD_RESET_CONTINUE_URL=https://auth.uzapay.co.ke/auth/password-reset-complete
STAFF_INVITATION_ACTION_BASE_URL=https://auth.uzapay.co.ke/staff/invitation
PLATFORM_ALERTS_URL=https://auth.uzapay.co.ke/platform/alerts

# Moves the Firebase action links (verify, reset, invitation password setup)
# off multitenant-pos-b8326.firebaseapp.com. The console's "Action URL" cannot
# be changed on this project (EMAIL_TEMPLATE_UPDATE_NOT_ALLOWED); see
# src/core/actionLink.ts.
AUTH_ACTION_LINK_ORIGIN=https://auth.uzapay.co.ke

# WhatsApp receipts (functions/src/whatsapp/config.ts). `unset` leaves the
# channel off: every receipt is recorded as not sent and nothing reaches Meta.
# Put the shared number's phone number ID here to turn it on; check the Graph
# version is still supported before each deploy.
WHATSAPP_PHONE_NUMBER_ID=unset
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
