rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function tenantPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId);
    }

    function staffPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId)/staff/$(request.auth.uid);
    }

    // **The membership half of the gate, with nothing said about the business.**
    // Split out on 2026-09-02 because the two halves answer different
    // questions: this one is "is this person still staff here", and the tenant
    // status below is "may this business be traded in at all".
    //
    // **Two documents is the ceiling, and that is why the root user document is
    // not read here.** Cross-service Rules allow no more than two *unique*
    // Firestore documents per evaluation; a third denies the request outright,
    // with a 403 indistinguishable from a rule that says no. This function used
    // to read `users/{uid}` as well as the two below, which put every upload and
    // every image read one document over the line - so the feature could not
    // work for anybody, in any tenant, with any data. Repeat reads of the two
    // paths here are free, because a document is cached for the evaluation.
    //
    // **What that costs.** `users/{uid}` carried `globalStatus == 'active'` and
    // `accountType == 'tenant_user'`. Suspending a user globally calls
    // `auth.updateUser(uid, {disabled: true})` and revokes their refresh tokens,
    // so a suspended account stops minting tokens and `request.auth` goes null
    // here on its own - but not before an already-issued ID token expires, up to
    // an hour later. Inside that window a just-suspended member keeps the
    // product images of a tenant whose staff record still says `active`.
    // `firestore.rules` closes the same window with `authValidAfterSeconds`;
    // this file never had that check, and cannot afford the read that would feed
    // it. Widening the gap to product images is the price of the feature
    // existing at all. Close it properly by having global suspension write
    // through to the staff records, which this gate already reads.
    function memberStanding(tenantId) {
      return request.auth != null
        && firestore.exists(tenantPath(tenantId))
        && firestore.exists(staffPath(tenantId))
        && firestore.get(staffPath(tenantId)).data.uid == request.auth.uid
        && firestore.get(staffPath(tenantId)).data.status == 'active'
        && firestore.get(staffPath(tenantId)).data.role
          in ['owner', 'admin', 'manager', 'cashier']
        && (
          firestore.get(staffPath(tenantId)).data.role != 'owner'
          || firestore.get(tenantPath(tenantId)).data.ownerUid == request.auth.uid
        );
    }

    // **A business that may be traded in.** The same two cases `firestore.rules`
    // names in its own `tradingTenant()`: approved, or a self-serve request
    // still inside the provisional window `requestTenant` opened for it.
    //
    // **This clause was missing here until 2026-09-02, and the gap had a shape.**
    // Firestore let a provisional business sell, count a till and print a
    // receipt; Storage let it do none of the one thing it needs a file for. A
    // shopkeeper who had just signed up could ring up a sale and could not put
    // a photograph on the product they were selling, until a platform
    // administrator approved them - which is not a week of real trading.
    //
    // `provisionalUntil` is type-checked rather than assumed, exactly as it is
    // in `firestore.rules`: a pending tenant written before the field existed
    // has none and must read as lapsed, not as permanently trading.
    function tradingTenant(tenantId) {
      return firestore.get(tenantPath(tenantId)).data.status == 'active'
        || (
          firestore.get(tenantPath(tenantId)).data.status == 'pending'
          && firestore.get(tenantPath(tenantId)).data.provisionalUntil is timestamp
          && request.time < firestore.get(tenantPath(tenantId)).data.provisionalUntil
        );
    }

    // **A business whose pictures may still be shown.** Mirrors
    // `readableTenant()`: a lapsed provisional business keeps its reads, because
    // its records are still readable and a catalog of broken images is a worse
    // account of the week than a catalog it can look at but not change.
    function readableTenant(tenantId) {
      return firestore.get(tenantPath(tenantId)).data.status in ['active', 'pending'];
    }

    function readingMember(tenantId) {
      return memberStanding(tenantId) && readableTenant(tenantId);
    }

    function inventoryManager(tenantId) {
      return memberStanding(tenantId)
        && tradingTenant(tenantId)
        && firestore.get(staffPath(tenantId)).data.role
          in ['owner', 'admin', 'manager'];
    }

    // **Custom metadata is not a condition of the write.** The two clauses that
    // compared `request.resource.metadata.tenantId` and `.productId` against the
    // path wildcards went on 2026-09-03. They authorised nothing: the path is
    // what `inventoryManager(tenantId)` is checked against, so an object landing
    // under this tenant's prefix is this tenant's object whatever its metadata
    // claims, and a member who can write here can write any metadata they like.
    // What the clauses did do is deny every upload that omitted them - reading a
    // field off a null `metadata` is an evaluation error, not a false - which
    // made an optional client convenience load-bearing for the whole feature.
    match /tenantProductImages/{tenantId}/{productId}/{imageId} {
      allow read: if readingMember(tenantId);
      allow create, update: if inventoryManager(tenantId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType
          in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if inventoryManager(tenantId);
    }
  }
}
